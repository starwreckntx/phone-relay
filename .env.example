# ===========================================================================
# Voice-Operated Telephony Agent — environment configuration
# Copy to `.env` and fill in your credentials.
# ===========================================================================

# --- Server ---------------------------------------------------------------
PORT=3000
NODE_ENV=development

# Public base URL of this service (used for Twilio status callbacks).
# In local dev this is your ngrok URL, e.g. https://abc123.ngrok.io
PUBLIC_URL=http://localhost:3000

# --- Twilio ---------------------------------------------------------------
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_NUMBER=+1234567890

# --- Speech-to-Text (Deepgram) --------------------------------------------
STT_PROVIDER=deepgram
STT_API_KEY=your_deepgram_key

# --- Text-to-Speech (optional) --------------------------------------------
TTS_PROVIDER=none
# TTS_API_KEY=

# --- LLM (Abacus RouteLLM) ------------------------------------------------
ABACUSAI_API_KEY=your_abacus_api_key

# --- Media stream WebSocket -----------------------------------------------
# URL Twilio connects to for bidirectional audio. Defaults to localhost for
# local dev; for Twilio integration set this (and PUBLIC_URL above) to your
# public ngrok URL, e.g. wss://your-ngrok-url/media-stream
VOICE_AGENT_WS_URL=ws://localhost:3000/media-stream

# --- Security -------------------------------------------------------------
# Bearer token required by the internal Conference/Contacts APIs.
INTERNAL_API_BEARER=your-secure-token

# ===========================================================================
# Browser / website calling (optional)
# ---------------------------------------------------------------------------
# In-browser (WebRTC) calling is configured on the WEBSITE, not here — it only
# needs a Twilio TwiML App whose Voice Request URL points at this agent:
#     https://<your-agent-host>/voice/incoming   (HTTP POST)
# See the "Calling the Agent from a Website" section in README.md.
# ===========================================================================

# ===========================================================================
# AI receptionist — ARC answers inbound calls (optional)
# ---------------------------------------------------------------------------
# Point your Twilio number's (or TwiML App's) Voice Request URL at:
#     https://<your-agent-host>/voice/arc/incoming   (HTTP POST)
# ARC greets the caller, listens (Twilio speech recognition), and answers with
# its own voice (Twilio <Say>) — the only external call is to ARC's brain, so
# no Deepgram/TTS keys are needed for this flow.
#
# ARC_CHAT_URL: ARC's public chat endpoint (the same bot as the website).
#   Requires ARC native mode enabled there (ARC_LLM_API_KEY set on the site),
#   or the endpoint returns 503 and the receptionist apologizes.
ARC_CHAT_URL=https://hueandlogic.com/api/arc/chat
# ARC_BRIEF_URL: where a captured brief is delivered when ARC decides to send
#   one (its `email` action). Defaults to the site's Resend-backed contact
#   endpoint, so no email credentials are needed on this box.
ARC_BRIEF_URL=https://hueandlogic.com/api/contact
# ARC_GREETING: first line spoken when a call connects.
ARC_GREETING=
# ARC_VOICE: Twilio <Say> voice. Default is a Google Studio voice (most
#   lifelike <Say> tier). Female: Google.en-US-Studio-O; male:
#   Google.en-US-Studio-Q. Neural options: Polly.Danielle-Neural, etc.
ARC_VOICE=Google.en-US-Studio-O
# ARC_MAX_TURNS: safety cap on conversation length before a polite wrap-up.
ARC_MAX_TURNS=20
# ARC_TIMEOUT_MS: per-request timeout when calling ARC's brain.
ARC_TIMEOUT_MS=15000
# ===========================================================================

# ===========================================================================
# Shadow agent — the owner's private voice agent (optional). See SHADOW.md.
# ---------------------------------------------------------------------------
# When SHADOW_ENABLED=true and the caller's number matches SHADOW_OWNER_NUMBER,
# ARC's /voice/arc/incoming redirects the call to Shadow; everyone else still
# gets ARC. Shadow has its own persona + brain and executes no actions.
SHADOW_ENABLED=false
# SHADOW_OWNER_NUMBER: your cell in E.164 (matched on the last 10 digits).
SHADOW_OWNER_NUMBER=
# SHADOW_PIN: optional DTMF second factor at entry — recommended, since caller
#   ID is spoofable. Leave blank to skip the PIN challenge.
SHADOW_PIN=
# SHADOW_CHAT_URL / SHADOW_API_KEY / SHADOW_MODEL: the brain. Any OpenAI-
#   compatible endpoint; defaults to the purpbox Kimi shim. Set the key to the
#   shim's bearer token so the funnel-exposed endpoint isn't an open proxy.
SHADOW_CHAT_URL=https://purpbox.tail902902.ts.net/v1/chat/completions
SHADOW_API_KEY=
SHADOW_MODEL=kimi-for-coding
# SHADOW_SYSTEM_PROMPT: override the built-in Shadow persona (optional).
SHADOW_SYSTEM_PROMPT=
# SHADOW_GREETING / SHADOW_VOICE / SHADOW_MAX_TURNS / SHADOW_TIMEOUT_MS.
SHADOW_GREETING=
SHADOW_VOICE=Google.en-US-Studio-O
SHADOW_MAX_TURNS=40
SHADOW_TIMEOUT_MS=20000
# ===========================================================================
